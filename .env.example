# Slack Bot Credentials (From Slack App Management)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-for-socket-mode
SLACK_SIGNING_SECRET=your-app-signing-secret

# Slack User Token (Required for Real-Time Search API / search.messages)
SLACK_USER_TOKEN=xoxp-your-user-token-with-search-read-scopes

# Optional AI Service Key for Advanced Synthesis (Gemini / OpenAI / Custom LLM)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# MCP Server Endpoints (Model Context Protocol)
GITHUB_MCP_SERVER_URL=http://localhost:8080/mcp
OPS_MCP_SERVER_URL=http://localhost:8081/mcp

# Server Port (HTTP mode)
PORT=3000
